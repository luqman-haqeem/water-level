{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://riverlevel.netlify.app",
          "https://*.netlify.app",
          "http://localhost:5173",
          "http://localhost:4173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["If-None-Match"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
