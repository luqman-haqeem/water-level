{
    // Runtime types come from `worker-configuration.d.ts`, generated by `wrangler types`
    // from wrangler.toml — it supersedes @cloudflare/workers-types and derives the Env
    // bindings from the config, so they cannot drift from what is actually bound.
    // Regenerate after editing wrangler.toml:  cd workers && npx wrangler types
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/vitest-plugin/types"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
